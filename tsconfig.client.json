{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "src/status-paths.ts",
    "src/client",
    "tests/plugin-card.spec.ts",
    "tests/probe-composer.spec.ts",
    "tests/slot-registration.spec.ts"
  ]
}
